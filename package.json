{
  "name": "@yuriyapostol/dyvo-vitepress",
  "version": "0.1.0",
  "description": "Reusable VitePress theme, features, and utilities",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./features/comments": {
      "types": "./src/features/comments/index.ts",
      "import": "./src/features/comments/index.ts"
    },
    "./features/news": {
      "types": "./src/features/news/index.ts",
      "import": "./src/features/news/index.ts"
    },
    "./theme/config": {
      "types": "./src/theme/config.ts",
      "import": "./src/theme/config.ts"
    },
    "./shared/i18n": {
      "types": "./src/shared/i18n.ts",
      "import": "./src/shared/i18n.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "npm run build:types",
    "build:types": "vue-tsc --declaration --emitDeclarationOnly --outDir dist",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "vitepress",
    "theme",
    "vue",
    "documentation"
  ],
  "dependencies": {
    "@vueuse/core": "^12.8.2"
  },
  "peerDependencies": {
    "vitepress": "^1.6.4",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@giscus/vue": "^3.1.1",
    "typescript": "^5.9.2",
    "vitepress": "^1.6.4",
    "vue": "^3.5.20",
    "vue-tsc": "^2.1.10"
  }
}
